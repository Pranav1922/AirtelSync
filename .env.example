# All variables are optional. The app runs fully offline with none of them set.

# Optional LLM: only phrases replies and parses free text the rules missed. Never picks products or prices.
ANTHROPIC_API_KEY=
SYNC_LLM_MODEL=claude-haiku-5-5

# Back-office console header key (change for any shared deployment)
SYNC_CONSOLE_KEY=demo-console

# 1 = specimen documents are accepted for demo validation; 0 = specimen watermark fails KYC
SYNC_DEMO_MODE=1

# Reference "today" for document date checks (dataset README)
SYNC_REFERENCE_DATE=2026-07-15

# Storage locations (defaults under backend/var/)
# SYNC_DB_PATH=backend/var/sync.db
# SYNC_UPLOAD_DIR=backend/var/uploads
# SYNC_DATA_DIR=YTL_TrackA_Udyam_Digital_Data
# SYNC_CORS_ORIGINS=http://localhost:5173
